# Copy to .env on the target host; never commit .env to git.

# Required: agent auth. Generate via `claude setup-token` on this host.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Required for Tier 4b real-shard download (HF single-file fallback)
# and any HF-API call that's not satisfied by the gcsfuse mount.
HF_TOKEN=hf_...

# --- Real-weight (Tier 8) deploy gate ---
# Set MOUNT_GCS=1 to have ./run.sh mount the bucket on launch. Leave
# unset / 0 to skip — Tiers 1–7 don't need this.
MOUNT_GCS=0

# GCS bucket holding the staged DeepSeek-V4-Flash HuggingFace cache layout.
# Default is the bucket the prior session staged the checkpoint into.
GCS_BUCKET=personal-mark-eu
GCS_ONLY_DIR=vllm/hub

# Optional gcsfuse tuning (sane defaults applied if unset):
# HF_HUB_MOUNT_DIR=/home/<you>/.cache/huggingface/hub
# GCS_CACHE_DIR=/dev/shm/gcsfuse-cache
# GCS_FILE_CACHE_MB=80000
# GCS_CLIENT_PROTOCOL=grpc

# --- TPU init (v6e single-VM) ---
# These default in scripts/loop.sh and scripts/preflight.sh; override here
# only if you have a non-standard topology. Without these, JAX hangs >60s
# on jax.devices('tpu') waiting for non-existent peer hosts.
# TPU_HOST_BOUNDS=1,1,1
# TPU_CHIPS_PER_HOST_BOUNDS=2,2,1

# --- Loop tuning ---
# Per-iteration `claude` timeout, in seconds. Default 5400 (90 min).
# ITER_TIMEOUT_SEC=5400

# --- Resilience: push after every iter ---
# The loop pushes `git push origin main` after every iteration so a host
# crash / stop doesn't lose work. Requires the ssh-agent to be unlocked
# (the loop runs ~/.ssh/ssh_askpass_helper.sh automatically if present).
# Set PUSH_ENABLED=0 to disable.
# PUSH_ENABLED=1
# PUSH_REMOTE=origin
# PUSH_BRANCH=main
