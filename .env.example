# Copy to .env on the head host; never commit .env to git.
# This file documents every env var the bringup scripts read.

# --- Required: agent auth ---
# Generate via `claude setup-token` on this host.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# --- Required: HuggingFace token ---
# DeepSeek-V4-Flash is a gated model. Token needs read access to
# `deepseek-ai/DeepSeek-V4-Flash`. The GCS bucket is the auth-free
# fast path for weights, but vLLM occasionally falls back to the HF
# API for tokenizer config — token avoids that being a launch blocker.
HF_TOKEN=hf_...

# --- GCS-mounted weights (real-weight serve gate) ---
# Set MOUNT_GCS=1 to have ./run.sh gcsfuse-mount the V4-Flash HuggingFace
# cache layout onto ~/.cache/huggingface/hub. Required for the smoke
# launcher; without it `vllm serve deepseek-ai/DeepSeek-V4-Flash` will
# try to download 543 GiB.
MOUNT_GCS=1

# Bucket holding the staged HF cache layout. Layout under the bucket
# must look like:
#   $GCS_BUCKET/$GCS_ONLY_DIR/models--deepseek-ai--DeepSeek-V4-Flash/
#                              snapshots/<sha>/{config.json,model-*.safetensors,...}
GCS_BUCKET=personal-mark-eu
GCS_ONLY_DIR=vllm/hub

# Optional gcsfuse tuning (sane defaults applied if unset):
# HF_HUB_MOUNT_DIR=/home/<you>/.cache/huggingface/hub
# GCS_CACHE_DIR=/dev/shm/gcsfuse-cache
# GCS_FILE_CACHE_MB=80000
# GCS_CLIENT_PROTOCOL=grpc

# --- TPU init ---
# These default in scripts/loop.sh and scripts/preflight.sh for v6e
# single-VM (TPU_HOST_BOUNDS=1,1,1, TPU_CHIPS_PER_HOST_BOUNDS=2,2,1).
# The full_slice_v4_smoke.sh launcher overrides these to multi-host
# values (TPU_HOST_BOUNDS=2,4,1, TPU_CHIPS_PER_HOST_BOUNDS=2,2,1) for
# the v6e-32 deploy. Override here only if your topology differs.
# TPU_HOST_BOUNDS=1,1,1
# TPU_CHIPS_PER_HOST_BOUNDS=2,2,1

# --- V4 loader knobs (forwarded to Ray workers by the smoke launcher) ---
# Documented in CLAUDE.md. Defaults are tuned for v6e-32 with the real
# V4-Flash checkpoint; override here only if you know what you want.
# V4_LOADER_SLICE_AWARE=1
# V4_LOADER_PLACE_WORKERS=8
# V4_LOADER_PREFETCH_WORKERS=0
# V4_JAX_CACHE_DIR=/tmp/jax-compile-cache-v4
# V4_XLA_FLAGS=

# --- Ray ---
# Bumped from default 300s — the first jit_run_model compile blows past
# 5min on a cold cache. Don't lower.
# RAY_CGRAPH_get_timeout=3600

# --- Loop tuning (only relevant if you use ./run.sh's autonomous loop) ---
# Per-iteration claude timeout, in seconds. Default 5400 (90 min).
# ITER_TIMEOUT_SEC=5400

# --- Resilience: push after every iter ---
# Pushes git commits to PUSH_REMOTE/PUSH_BRANCH after each iter so a
# host crash / stop doesn't lose work. Requires the ssh-agent to be
# unlocked (the loop runs ~/.ssh/ssh_askpass_helper.sh automatically
# if present). Set PUSH_ENABLED=0 to disable.
# PUSH_ENABLED=1
# PUSH_REMOTE=origin
# PUSH_BRANCH=main
